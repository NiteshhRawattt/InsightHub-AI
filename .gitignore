# ============================================================
#  InsightHub AI — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.npm
.eslintcache
*.tsbuildinfo
.pnp.*

# ── Environment / Secrets — NEVER COMMIT THESE ──────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── ChromaDB / Data / Uploads ────────────────────────────────
data/
chroma_data/
uploads/
*.sqlite3
*.db

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Docker ───────────────────────────────────────────────────
.docker/

# ── IDE / Editors ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Testing ──────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
