# ============================================================
#  InsightHub AI — Git Attributes
#  Normalizes line endings across platforms
# ============================================================

# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
