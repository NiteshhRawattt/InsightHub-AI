# ============================================================
#  InsightHub AI — Environment Variables Template
#
#  INSTRUCTIONS:
#    1. Copy this file:   cp .env.example .env
#    2. Fill in your values below
#    3. NEVER commit .env to Git — it's in .gitignore
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME="InsightHub AI"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Google Gemini AI ─────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ── CORS — Allowed Frontend Origins ──────────────────────────
# JSON array format. Add your production domain when deploying.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── ChromaDB Vector Database ─────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=insighthub_docs

# ── File Uploads ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# ── Backend Server ───────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend (Vite) ──────────────────────────────────────────
# These are injected at build time — prefix with VITE_ to expose to browser
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="InsightHub AI"
